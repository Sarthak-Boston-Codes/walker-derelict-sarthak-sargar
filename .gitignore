# Godot editor cache
godot/.godot/

# Large media (course storage, not GitHub)
*.mp4
*.mp3
youtube/**/*.avi
# Film build audio (compile.py intermediates, e.g. clips/_work/master.wav ~56 MB).
# Scoped to youtube/: the game's own WAVs in godot/audio/ must stay committed.
youtube/**/*.wav
__pycache__/
# Blender auto-backup files (written on every re-save).
*.blend1

# Test logs (scripts/run-test.sh); cited logs are copied to docs/evidence/
logs/
# Full-size A5 capture frames (regenerated by godot/tools/a5_capture.gd); small crops are kept in docs/evidence/captures/
youtube/claude-liam-derelict-a5-gamedev/captures/frames/
